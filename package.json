  "publisher": "vstirbu",
  "bugs": {
    "url": "https://github.com/vstirbu/vscode-mermaid-preview/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vstirbu/vscode-mermaid-preview.git"
  },
  "icon": "images/favicon.png",
  "galleryBanner": {
    "color": "#5c2d91",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.77.0"
  },
  "categories": [
    "Visualization"
