    "journey",
    "pie",
    "sequence",
    "flow",
    "flow chart",
    "gantt chart",
    "architecture",
    "uml"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "activationEvents": [
    "onLanguage",
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "markdown.previewScripts": [
      "./dist-preview/bundle.js"
    ],
    "markdown.markdownItPlugins": true,
