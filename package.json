    "configuration": {
      "title": "Mermaid Preview",
      "properties": {
        "mermaid.vscode.dark_theme": {
          "type": "string",
          "enum": [
            "neo-dark",
            "redux-dark",
            "redux-dark-color",
            "dark"
          ],
          "default": "neo-dark",
          "description": "Default mermaid theme used for dark theme"
        },
        "mermaid.vscode.light_theme": {
          "type": "string",
          "enum": [
            "neo",
            "redux",
            "null",
            "default",
            "base",
            "forest",
            "neutral",
            "redux-color",
            "mc"
          ],
          "default": "neo",
          "description": "Default mermaid theme used for light theme"
        },
        "mermaid.vscode.max_Zoom": {
          "type": "number",
          "default": 5,
          "description": "Defines the maximum zoom level for diagrams, specified as a multiple of 100%. For example, a value of 5 means the maximum zoom is 500%."
        },
        "mermaid.vscode.max_CharLength": {
          "type": "number",
          "default": 90000,
          "description": "Maximum number of characters allowed in a diagram's source"
        },
        "mermaid.vscode.max_Edges": {
          "type": "number",
          "default": 1000,
          "description": "Maximum number of edges allowed in a diagram's source"
        },
        "preview.mermaid.baseUrl": {
          "type": "string",
          "default": "https://www.mermaid.ai",
          "description": "Base URL used for extension usage analytics"
        },
        "preview.mermaid.enableTelemetry": {
          "type": "boolean",
          "default": true,
          "description": "Allow Mermaid Preview to send anonymous preview failure analytics. Turn this off to stop all analytics. VS Code's telemetry setting must also be enabled."
        },
        "preview.mermaid.showFeaturePopups": {
          "type": "boolean",
          "default": true,
          "description": "Show notifications when a feature has moved to the Mermaid Chart extension."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mermaidActivityBar",
          "title": "Mermaid Preview",
          "icon": "images/mermaid-icon-32-preview.svg",
          "when": "mermaidPreview:isActive"
        }
      ]
    },
    "views": {
      "mermaidActivityBar": [
        {
          "id": "preview_mermaidWebview",
          "name": "Mermaid Preview",
          "type": "webview",
          "when": "mermaidPreview:isActive"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "preview.mermaidChart.diagramHelp",
          "when": "view == preview_mermaidWebview && mermaidPreview:isActive",
          "group": "navigation@1"
        },
        {
          "command": "preview.mermaidChart.reloadSidebar",
          "when": "view == preview_mermaidWebview && mermaidPreview:isActive",
          "group": "navigation@2"
        },
        {
          "command": "preview.mermaidChart.openSettings",
          "when": "view == preview_mermaidWebview && mermaidPreview:isActive",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "preview.mermaidChart.insertUuidIntoEditor",
          "when": "viewItem == document && mermaidPreview:isActive",
          "group": "inline@01"
        }
      ],
      "editor/context": [
        {
          "command": "preview.mermaidChart.preview",
          "when": "(resourceExtname =~ /^\\.(mmd|mermaid)$/ || resourceLangId =~ /^mermaid/) && mermaidPreview:isActive",
          "group": "navigation"
        },
        {
          "command": "preview.mermaidChart.connectDiagramToMermaidChart",
          "when": "(resourceExtname =~ /^\\.(mmd|mermaid)$/ || resourceLangId =~ /^mermaid/) && mermaidPreview:isActive",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "key": "ctrl+s",
        "command": "preview.mermaidChart.syncDiagramWithMermaid",
        "when": "editorLangId =~ /^mermaid/ && mermaidPreview:isActive"
      },
      {
        "key": "cmd+s",
        "command": "preview.mermaidChart.syncDiagramWithMermaid",
        "when": "editorLangId =~ /^mermaid/ && mermaidPreview:isActive",
        "mac": "cmd+s"
      }
    ],
    "commands": [
      {
        "command": "preview.mermaidChart.diagramHelp",
        "title": "Diagram help",
        "icon": {
          "light": "images/icons/help-light.svg",
          "dark": "images/icons/help-dark.svg"
        },
        "category": "Mermaid Preview",
        "when": "mermaidPreview:isActive"
      },
      {
        "command": "preview.mermaidChart.reloadSidebar",
        "title": "Reload",
        "icon": {
          "light": "images/icons/refresh-light.svg",
          "dark": "images/icons/refresh-dark.svg"
        },
        "category": "Mermaid Preview",
        "when": "mermaidPreview:isActive"
      },
      {
        "command": "preview.mermaidChart.openSettings",
        "title": "Settings",
        "icon": {
          "light": "images/icons/settings-light.svg",
          "dark": "images/icons/settings-dark.svg"
        },
        "category": "Mermaid Preview",
        "when": "mermaidPreview:isActive"
      },
      {
        "command": "preview.mermaidChart.preview",
        "title": "Preview Diagram",
        "category": "Mermaid Preview",
        "when": "mermaidPreview:isActive"
      },
      {
        "command": "preview.mermaidChart.createMermaidFile",
        "title": "Create Diagram",
        "category": "Mermaid Preview",
        "when": "mermaidPreview:isActive"
      },
      {
        "command": "preview.mermaidChart.syncDiagramWithMermaid",
        "title": "Sync Diagram",
        "category": "Mermaid Preview",
        "when": "mermaidPreview:isActive"
      },
      {
        "command": "preview.mermaidChart.connectDiagramToMermaidChart",
        "title": "Connect Diagram",
        "category": "Mermaid Preview",
        "when": "mermaidPreview:isActive"
      },
      {
        "command": "preview.mermaidChart.insertUuidIntoEditor",
        "title": "Link Diagram",
        "category": "Mermaid Preview",
        "when": "mermaidPreview:isActive"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "pnpm compile",
    "precompile": "pnpm --filter ./webview build",
    "compile": "tsc -p ./ --noEmit && esbuild ./src/extension.ts --sourcemap --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --minify",
    "watch": "tsc -p ./ --noEmit --watch",
    "pretest": "pnpm compile && pnpm lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "package": "pnpm vsce package --no-dependencies",
    "publish": "pnpm vsce publish --no-dependencies"
  },
  "devDependencies": {
    "@types/axios": "^0.14.4",
    "@types/express": "^5.0.0",
    "@types/glob": "^8.1.0",
    "@types/markdown-it": "^14.1.2",
    "@types/mocha": "^10.0.1",
